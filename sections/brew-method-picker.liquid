{% comment %}
  Brew Method Picker — distinctive homepage section for coffee shops.
  Each block is a brew method linking to a filtered collection.
  Merchant editable: blocks for each method, custom icon choice per block.
{% endcomment %}

<link rel="stylesheet" href="{{ 'brew-method-picker.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'brew-method-picker.css' | asset_url | stylesheet_tag }}</noscript>

<section
  class="brew-picker color-{{ section.settings.color_scheme }} gradient"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="brew-picker__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="brew-picker__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <ul class="brew-picker__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="brew-picker__item" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}" class="brew-picker__link">
            <div class="brew-picker__icon">
              {%- render 'brew-method-icon', icon: block.settings.icon -%}
            </div>
            <span class="brew-picker__label">{{ block.settings.label }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Brew method picker",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How do you brew?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find coffee suited to your method."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "method",
      "name": "Brew method",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "AeroPress"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Collection link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "aeropress", "label": "AeroPress" },
            { "value": "pourover", "label": "Pour Over" },
            { "value": "espresso", "label": "Espresso" },
            { "value": "french-press", "label": "French Press" },
            { "value": "cold-brew", "label": "Cold Brew" },
            { "value": "moka", "label": "Moka Pot" },
            { "value": "drip", "label": "Drip" }
          ],
          "default": "aeropress"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Brew method picker",
      "blocks": [
        { "type": "method", "settings": { "label": "AeroPress", "icon": "aeropress" } },
        { "type": "method", "settings": { "label": "Pour Over", "icon": "pourover" } },
        { "type": "method", "settings": { "label": "Espresso", "icon": "espresso" } },
        { "type": "method", "settings": { "label": "French Press", "icon": "french-press" } },
        { "type": "method", "settings": { "label": "Cold Brew", "icon": "cold-brew" } }
      ]
    }
  ]
}
{% endschema %}
